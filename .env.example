# AgentFlow 环境变量 — 复制为 .env 并填入实际值
# cp .env.example .env

# --- 应用 ---
SECRET_KEY=change-me-to-a-random-string
DEBUG=true

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (至少配置一个) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
QWEN_API_KEY=sk-your-qwen-key

# --- Search (pick one backend, default: duckduckgo) ---
SEARCH_BACKEND=searxng
# SEARXNG_URL=http://localhost:8080   # for searxng backend
# TAVILY_API_KEY=your-tavily-key       # for tavily backend
# BRAVE_API_KEY=your-brave-key         # for brave backend
